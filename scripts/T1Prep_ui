#!/usr/bin/env bash
# Source-tree dev wrapper for the T1Prep Web UI (Flask).
# Installed users should use the `t1prep-ui` console script from <venv>/bin.
# Usage:
#   ./scripts/T1Prep_ui [PORT] [--no-browser]
# Examples:
#   ./scripts/T1Prep_ui
#   ./scripts/T1Prep_ui 5500
#   ./scripts/T1Prep_ui --no-browser
#   ./scripts/T1Prep_ui 5500 --no-browser

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

PORT="5050"
if [[ "${1-}" =~ ^[0-9]+$ ]]; then
    PORT="$1"
    shift
fi

# Dual-mode path resolution shared with T1Prep: sets root_dir and T1prep_env.
# shellcheck source=scripts/T1Prep_utils.sh
source "$SCRIPT_DIR/T1Prep_utils.sh"

# Prepend src/ to PYTHONPATH, so the app resolves from the source tree ahead of
# a pip-installed t1prep, and activate env/ when there is one.  A missing venv
# is not fatal: the UI needs only T1Prep's Python dependencies, so the
# interpreter T1Prep was pip installed into works as well ($T1PREP_PYTHON
# picks one explicitly) -- see activate_t1prep_env() in T1Prep_utils.sh.
activate_t1prep_env

cd "$PROJECT_DIR"

# Run the packaged Flask app (t1prep.webui.app) on the chosen port.
exec "${python}" -m t1prep.webui.app --port "$PORT" "$@"
